{
  "name": "vue-portfolio-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:docker": "vite --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.js --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "resume": "node resume/build-resume.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "bootstrap": "^5.3.9",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
